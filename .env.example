# 한국관광공사 TourAPI (공공데이터포털 "한국관광공사_국문 관광정보 서비스_GW")
# 반드시 "디코딩(Decoding)" 서비스키를 넣을 것 — 인코딩 키를 넣으면 이중 인코딩되어 인증 실패함.
TOUR_API_KEY=

# TMAP (SK Open API, apis.openapi.sk.com) appKey
TMAP_APP_KEY=

# TMAP Transit(대중교통 경로 안내, SK Open API — apis.openapi.sk.com/transit/routes) —
# 두 장소 사이의 실제 지하철/버스 이동 안내(어느 역/정류장, 몇 호선, 몇 번 버스, 몇 정거장)에
# 사용. 서버 전용 — 절대 NEXT_PUBLIC_*로 노출하지 말 것. 기존 TMAP 자동차 길찾기
# (TMAP_APP_KEY)와는 완전히 다른 상품/쿼터라 같은 키를 재사용하지 않는다 — 반드시 SK Open
# API 포털에서 "대중교통 경로 안내(Public Transit)" 상품을 별도로 신청해 발급받은 키를 넣을 것.
#
# 무료 플랜은 10회/일 쿼터라, 사용자가 화면을 열 때 자동으로는 절대 호출하지 않는다 —
# "상세 대중교통 경로 보기"를 직접 누르고 로그인돼 있을 때만, 그것도 캐시가 없고 아래
# 예산 안일 때만 호출한다(src/app/api/transit/route.ts, src/lib/transit/quota.ts 참고).
# 키가 없거나 요청이 실패하면 TMAP/Haversine 추정 소요시간("대중교통 · 약 N분")으로만
# 폴백하고, 역/버스 정보를 지어내지 않는다.
TMAP_TRANSIT_API_KEY=

# TMAP Transit 기능 자체를 켜는 스위치. "true"일 때만 활성화 — 그 외(없음 포함)는 항상
# 비활성화(ODSAY_ENABLED와 반대 극성 — 검증된 키 없이 실수로 켜지는 사고를 막기 위한
# 안전한 기본값). 꺼져 있어도 MovementGuide는 TMAP 이동시간/Haversine 추정치 + 지도 링크로
# 정상 동작한다.
TMAP_TRANSIT_ENABLED=false

# STARA 자체 일일 TMAP Transit 호출 예산 — 무료 플랜 실제 한도 10회/일보다 낮게 잡아
# 운영 여유를 둔다(기본 8회 = 2회 여유분). 원자적 DB 카운터(api_daily_usage, provider
# "tmap_transit")로 소진 여부를 판정하며, 소진되면 호출하지 않고 기존 추정치로만
# 폴백한다. 비어있거나 잘못된 값이면 보수적 기본값(8)을 쓴다.
TMAP_TRANSIT_DAILY_BUDGET=8

# 같은 구간(출발/도착 좌표+로케일) 상세 경로 응답을 짧게 재사용하는 서버 캐시의 TTL(분).
# TMAP 약관상 API 파생 데이터를 24시간 이상 보관/재사용할 수 없어서, 아무리 크게 잡아도
# 1380분(23시간)을 넘는 값은 코드가 자동으로 클램프한다. 기본 360분(6시간).
TMAP_TRANSIT_CACHE_TTL_MINUTES=360

# ODsay Lab 대중교통 경로 안내 API — 더 이상 STARA의 상세 대중교통 제공사가 아니다
# (레거시, 비활성 — src/lib/transit/odsayClient.ts 참고). Vercel Hobby 환경에서 ODsay
# Server키가 요구하는 고정 아웃바운드 IP를 안전하게 충족할 방법이 없어 TMAP Transit으로
# 교체했다. 코드는 아직 남아있지만(운영 검증 후 완전히 제거 예정) 항상 비활성 상태를
# 유지할 것 — 값을 채우더라도 ODSAY_ENABLED가 "false"가 아니면 안 된다.
ODSAY_API_KEY=
ODSAY_DAILY_BUDGET=25
ODSAY_ENABLED=false

# 아래 값들은 선택 사항 — 비워두면 코드 기본값(apis.data.go.kr / apis.openapi.sk.com)을 사용함
TOUR_API_BASE_URL=
# 영문 관광정보 서비스_GW (같은 TOUR_API_KEY를 그대로 사용). locale=en 요청 시 사용, 없으면 국문 데이터로 폴백.
TOUR_API_EN_BASE_URL=
# 관광지별 연관 관광지 정보 서비스 (같은 TOUR_API_KEY를 그대로 사용, data.go.kr에서 별도 활용신청 필요)
TOUR_API_RELATED_BASE_URL=
TMAP_API_BASE_URL=
ODSAY_API_BASE_URL=
TMAP_TRANSIT_API_BASE_URL=

# 아티스트 장소 주변 관광정보 검색 반경(m), 비워두면 기본값 2000
TOUR_SEARCH_RADIUS_METERS=

# Anthropic API — T-money 카드 인증 세그먼트 퀘스트(사진 판별, Claude Vision)에서만 사용.
# 서버 전용 — 절대 NEXT_PUBLIC_*로 노출하지 말 것. 키가 없으면 이 퀘스트는 500을 반환하고
# 완료 처리되지 않는다(다른 기능에는 영향 없음).
ANTHROPIC_API_KEY=
# 선택 — 비워두면 코드 기본값(claude-sonnet-5)을 사용함
ANTHROPIC_MODEL=
