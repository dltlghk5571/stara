# 한국관광공사 TourAPI (공공데이터포털 "한국관광공사_국문 관광정보 서비스_GW")
# 반드시 "디코딩(Decoding)" 서비스키를 넣을 것 — 인코딩 키를 넣으면 이중 인코딩되어 인증 실패함.
TOUR_API_KEY=

# TMAP (SK Open API, apis.openapi.sk.com) appKey
TMAP_APP_KEY=

# ODsay Lab 대중교통 경로 안내 API (openapi.odsay.com) — 두 장소 사이의 실제 지하철/버스
# 이동 안내(어느 역/정류장, 몇 호선, 몇 번 버스, 몇 정거장)에 사용. 서버 전용 — 절대
# NEXT_PUBLIC_*로 노출하지 말 것. 키가 없거나 요청이 실패하면 TMAP/Haversine 추정 소요시간
# ("대중교통 · 약 N분")으로만 폴백하고, 역/버스 정보를 지어내지 않는다.
#
# Basic 플랜은 30회/일 쿼터라, 사용자가 화면을 열 때 자동으로는 절대 호출하지 않는다 —
# "상세 대중교통 경로 보기"를 직접 눌렀을 때만, 그것도 아래 예산 안에서만 호출한다
# (src/app/api/transit/route.ts, src/lib/transit/quota.ts 참고). ODsay 응답은 어디에도
# 저장/재사용하지 않는다(ODsay 정책상 응답값 저장이 금지돼 있음).
ODSAY_API_KEY=

# STARA 자체 일일 ODsay 호출 예산 — Basic 플랜 30회/일보다 낮게 잡아 여유를 둘 것(예: 25).
# 원자적 DB 카운터(api_daily_usage)로 소진 여부를 판정하며, 소진되면 ODsay를 호출하지 않고
# 기존 추정치로만 폴백한다. 비어있거나 잘못된 값이면 보수적 기본값(20)을 쓴다.
ODSAY_DAILY_BUDGET=25

# ODsay 자체를 완전히 끄는 킬 스위치. "false"로만 설정하면 비활성화 — 그 외(없음 포함)는
# 활성화. 꺼져 있어도 MovementGuide는 TMAP/Haversine 추정치 + 지도 링크로 정상 동작한다.
ODSAY_ENABLED=true

# 아래 값들은 선택 사항 — 비워두면 코드 기본값(apis.data.go.kr / apis.openapi.sk.com)을 사용함
TOUR_API_BASE_URL=
# 영문 관광정보 서비스_GW (같은 TOUR_API_KEY를 그대로 사용). locale=en 요청 시 사용, 없으면 국문 데이터로 폴백.
TOUR_API_EN_BASE_URL=
# 관광지별 연관 관광지 정보 서비스 (같은 TOUR_API_KEY를 그대로 사용, data.go.kr에서 별도 활용신청 필요)
TOUR_API_RELATED_BASE_URL=
TMAP_API_BASE_URL=
ODSAY_API_BASE_URL=

# 아티스트 장소 주변 관광정보 검색 반경(m), 비워두면 기본값 2000
TOUR_SEARCH_RADIUS_METERS=

# Anthropic API — T-money 카드 인증 세그먼트 퀘스트(사진 판별, Claude Vision)에서만 사용.
# 서버 전용 — 절대 NEXT_PUBLIC_*로 노출하지 말 것. 키가 없으면 이 퀘스트는 500을 반환하고
# 완료 처리되지 않는다(다른 기능에는 영향 없음).
ANTHROPIC_API_KEY=
# 선택 — 비워두면 코드 기본값(claude-sonnet-5)을 사용함
ANTHROPIC_MODEL=
