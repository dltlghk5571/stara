# 이 파일을 복사해서 .env로 만들고 실제 값을 채우세요.
#   cp .env.example .env
# .env는 .gitignore에 포함되어 있어서 git에 올라가지 않습니다.

# Map-It과 공유하는 Kakao Developers 앱의 REST API 키.
# developers.kakao.com > 내 애플리케이션 > (Map-It용 앱) > 앱 키 탭 에서 복사.
# (JS 키가 아니라 REST API 키 — 서버사이드 배치 스크립트용)
KAKAO_REST_API_KEY=

# fill_hours.py(영업시간 채우기)용 Google Places API (New) 키.
# Google Cloud Console > API 및 서비스 > 사용 설정된 API > "Places API (New)" 활성화 후
# 사용자 인증 정보에서 발급. 키 제한을 "Places API (New)"로 걸어둘 것 — 다른 API에 새는 것 방지.
GOOGLE_PLACES_API_KEY=

# naver_hub.py(NAVER API HUB 연동 - source_url 자동 채우기/좌표 교차검증)용.
# developers.naver.com이 아니라 NCP(네이버클라우드 플랫폼) 콘솔 > API HUB > Application에서
# 발급 (2026-07-31부로 구 개발자센터 검색 API 신규 등록 중단, naver-api-hub-integration.md 참고).
NAVER_HUB_CLIENT_ID=
NAVER_HUB_CLIENT_SECRET=
